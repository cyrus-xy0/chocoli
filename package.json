{
  "name": "life-cabin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.mjs",
    "dev:web": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "express": "^4.19.2",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "concurrently": "^9.1.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=25"
  }
}
